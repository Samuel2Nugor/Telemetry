# MQTT broker address used inside Docker Compose
MQTT_HOST=mosquitto
MQTT_PORT=1883

# Dedicated account for the Python telemetry service
MQTT_USERNAME=telemetry-service
MQTT_PASSWORD=replace-with-local-password

# MQTT client configuration
MQTT_CLIENT_ID=telemetry-service
MQTT_KEEPALIVE_SECONDS=60

# InfluxDB initial setup
INFLUXDB_ADMIN_USERNAME=telemetry-admin
INFLUXDB_ADMIN_PASSWORD=replace-with-strong-local-password
INFLUXDB_ADMIN_TOKEN=replace-with-long-random-local-token
INFLUXDB_ORG=telemetry
INFLUXDB_BUCKET=telemetry
INFLUXDB_RETENTION=30d

# Grafana administrator
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-local-password

# Dedicated MQTT account for Telegraf
TELEGRAF_MQTT_USERNAME=telegraf
TELEGRAF_MQTT_PASSWORD=replace-with-local-password
