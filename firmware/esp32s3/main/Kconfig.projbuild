menu "Telemetry configuration"

    menu "Device"

        config TELEMETRY_DEVICE_ID
            string "Device ID"
            default "esp32s3-01"
            help
                Stable identifier used in the telemetry payload, MQTT client ID
                and MQTT topic path.

        config TELEMETRY_INTERVAL_MS
            int "Telemetry interval (milliseconds)"
            range 1000 3600000
            default 5000
            help
                Time between the start of consecutive sensor-reading cycles.

    endmenu

    menu "Wi-Fi"

        config TELEMETRY_WIFI_SSID
            string "Wi-Fi SSID"
            default ""

        config TELEMETRY_WIFI_PASSWORD
            string "Wi-Fi password"
            default ""

    endmenu

    menu "MQTT"

        config TELEMETRY_MQTT_BROKER_URI
            string "MQTT broker URI"
            default ""

        config TELEMETRY_MQTT_USERNAME
            string "MQTT username"
            default ""

        config TELEMETRY_MQTT_PASSWORD
            string "MQTT password"
            default ""

    endmenu

    menu "SHT31"

        config TELEMETRY_SHT31_SDA_GPIO
            int "SDA GPIO"
            range 0 48
            default 8

        config TELEMETRY_SHT31_SCL_GPIO
            int "SCL GPIO"
            range 0 48
            default 9

    endmenu

    menu "DS18B20"

        config TELEMETRY_ONEWIRE_GPIO
            int "1-Wire GPIO"
            range 0 48
            default 5

        config TELEMETRY_ONEWIRE_UART_PORT
            int "1-Wire UART port"
            range 0 2
            default 1

        config TELEMETRY_WATER_DS18B20_ROM
            hex "Water probe ROM address"
            default 0xBE0000006DEFD428

        config TELEMETRY_EXTERNAL_DS18B20_ROM
            hex "External probe ROM address"
            default 0xDA00000070118128

    endmenu

endmenu
